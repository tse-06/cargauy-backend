POSTGRES_DB=cargauy
POSTGRES_USER=cargauy_app
POSTGRES_PASSWORD=changeme

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=cargauy_tracking

MONGO_LOGICA_USER=logica_ro
MONGO_LOGICA_PASSWORD=changeme

MONGO_INGESTA_USER=ingesta_rw
MONGO_INGESTA_PASSWORD=changeme

KAFKA_CLUSTER_ID=5H8ddZmdEbPKcmCzzypGcA

JWT_SECRET=dev-only-jwt-secret-cargauy-0123456789abcdef

# Vigencia en minutos de los JWT segun el rol activo (opcionales; ServicioJwt
# tiene un valor por defecto para cada uno: ADMINISTRADOR 30, AUTORIDAD 120,
# FUNCIONARIO 480, ENCARGADO_EMPRESA 480, CHOFER 43200)
# JWT_EXPIRACION_MINUTOS_ADMINISTRADOR=30
# JWT_EXPIRACION_MINUTOS_CHOFER=43200

# Directorio donde wildfly-logica guarda el contenido de los archivos subidos
# (repartido en subdirectorios segun la clave). En desarrollo se monta el
# directorio ./archivos del proyecto en esta ruta
ARCHIVOS_DIRECTORIO=/var/lib/cargauy/archivos

# URLs firmadas de descarga de archivos (ver FirmaArchivos). URL publica de la
# API, sin barra final: las URLs quedan como <base>/archivos/<id firmado>
ARCHIVOS_URL_BASE=http://localhost:8080/api
# Clave HMAC que firma las URLs: base64 de al menos 32 bytes
# (openssl rand -base64 32). Distinta de JWT_SECRET y AUTH_FLOW_KEY
ARCHIVOS_URL_SECRETO=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
# Vigencia en minutos de las URLs (opcional, por defecto 5)
# ARCHIVOS_URL_VIGENCIA_MINUTOS=5

# --- Login con gub.uy (ID Uruguay, OpenID Connect) ---
# Valores que da AGESIC al registrar la RP (confirmar la URL del issuer de testing
# en la documentacion tecnica de ID Uruguay)
GUBUY_ISSUER=https://auth-testing.iduruguay.gub.uy/oidc/v1
GUBUY_CLIENT_ID=changeme
GUBUY_CLIENT_SECRET=changeme
# Debe coincidir con la redirect_uri registrada en AGESIC (context-root /api)
GUBUY_REDIRECT_URI=http://localhost:8080/api/auth/gubuy/callback
# Destinos permitidos tras el login (separados por coma): frontend web y deep link de la app movil.
# El primero es el destino por defecto
GUBUY_ALLOWED_RETURN=http://localhost:3000/,cargauy://auth
# Clave que firma la cookie del flujo de login: base64 de al menos 32 bytes
# (openssl rand -base64 32). Distinta de JWT_SECRET
AUTH_FLOW_KEY=AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
# Solo en desarrollo local sin HTTPS
GUBUY_COOKIE_SECURE=false
# Opcionales (ver GubUyConfigProducer): GUBUY_SCOPES, GUBUY_PKCE, GUBUY_DOCUMENT_CLAIM, GUBUY_LEVEL_CLAIM
GUBUY_ALLOW_WEAK_RSA=true

# Personas para la PDI simulada
PDI_PERSONAS=TU_CEDULA;TuNombre;TuApellido;AAAA-MM-DD

# Origenes de los fronts permitidos por CORS (sin path; sin ellos el navegador
# bloquea las llamadas a la API)
FRONTOFFICE_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001
